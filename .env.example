NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/queue_ready_api
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Redis is intentionally configured but unused by a queue library.
# Keep this here so BullMQ can be introduced later without reshaping app config.
REDIS_URL=redis://localhost:6379

# Email provider settings are abstracted behind EmailService.
EMAIL_FROM=no-reply@example.com
